<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcarrascoT5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout Padding="15" Spacing="15">
        <Label 
            Text="Semana 5: BASE DE DATOS LOCALES"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="txtName"
               Placeholder="Ingresa el nombre"/>

        <Grid Padding="5" RowSpacing="5" ColumnSpacing="5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAgregar"
                    Text="Agreagr Persona"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            <Label x:Name="lblStatusMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0"
                />
            <Button x:Name="btnMostrar"
                    Text="Mostrar personas"
                    Clicked="btnMostrar_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>

            <Button x:Name="btnEliminar"
                    Text="Eliminar persona seleccionada"
                    Clicked="btnEliminar_Clicked"
                    Grid.Row="3"
                    Grid.Column="0"/>

            <CollectionView x:Name="listaPersonas"
                            SelectionMode="Single"
                            SelectionChanged="listaPersonas_SelectionChanged"
                            Grid.Row="4"
                            Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                   Grid.Row="0"
                                   Grid.Column="0"/>

                            <Label Text="{Binding Name}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
            
        </Grid>

        
    </VerticalStackLayout>
</ContentPage>