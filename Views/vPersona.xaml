<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcarrascoT5.Views.vPersona"
             Title="vPersona">

    <ContentPage.Resources>
        <Style x:Key="EstiloBoton" TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HeightRequest" Value="48"/>
        </Style>
    </ContentPage.Resources>
    
    
    <Grid Padding="15"
              RowSpacing="15"
              RowDefinitions="Auto,Auto,*">
        <Label 
            Text="Semana 5: BASE DE DATOS LOCALES"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#512BD4"
            HorizontalOptions="Center"
            Grid.Row="0"/>

        <Entry x:Name="txtName"
               Placeholder="Ingresa el nombre"
               ClearButtonVisibility="WhileEditing"
               Grid.Row="1"/>

        <Grid Padding="5" RowSpacing="5" ColumnSpacing="5" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAgregar"
                    Text="Agregar Persona"
                    Style="{StaticResource EstiloBoton}"
                    Clicked="btnAgregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            
            <Label x:Name="lblStatusMessage"
                   TextColor="#C62828"
                   Grid.Row="1"
                   Grid.Column="0"/>
            
            <Button x:Name="btnMostrar"
                    Text="Mostrar personas"
                    Style="{StaticResource EstiloBoton}"
                    Clicked="btnMostrar_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>

            <Button x:Name="btnEliminar"
                    Text="Eliminar persona seleccionada"
                    Style="{StaticResource EstiloBoton}"
                    Clicked="btnEliminar_Clicked"
                    Grid.Row="3"
                    Grid.Column="0"/>

            <Button x:Name="btnActualizar"
                    Text="Actualizar persona seleccionada"
                    Style="{StaticResource EstiloBoton}"
                    Clicked="btnActualizar_Clicked"
                    Grid.Row="4"
                    Grid.Column="0"/>

            <CollectionView x:Name="listaPersonas"
                            SelectionMode="Single"
                            SelectionChanged="listaPersonas_SelectionChanged"
                            Grid.Row="5"
                            Grid.Column="0">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="50,*"
                            Padding="10,5">
                        <Label Text="ID"
                               FontAttributes="Bold"
                               TextColor="#555555"/>

                        <Label Text="Nombre"
                               FontAttributes="Bold"
                               TextColor="#555555"
                               Grid.Column="1"/>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#DDDDDD"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10"
                                Margin="0,3">
                            <Grid ColumnDefinitions="50, *"
                                  ColumnSpacing="10">
                                
                                <Label Text="{Binding Id, StringFormat='#{0}'}"
                                       TextColor="#512bd4"
                                       VerticalOptions="Center"
                                       FontAttributes="Bold"
                                       />

                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       Grid.Column="1"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>
            
        </Grid>

        
    </Grid>
</ContentPage>